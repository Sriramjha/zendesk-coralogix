# Zendesk Support API
# Admin Center → Apps and integrations → APIs → Zendesk API → Add API token
# The email is the API username (email/token), not a password login.
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=admin@example.com
ZENDESK_API_TOKEN=your-zendesk-api-token

# Optional: zendesk.com (default), zendesk.eu, zendesk.com.au
# ZENDESK_DOMAIN=zendesk.com
# Optional full override, e.g. https://your-subdomain.zendesk.com
# ZENDESK_BASE_URL=

# Optional OAuth access token instead of API token + email
# ZENDESK_OAUTH_TOKEN=

# Optional filters (comma-separated). Leave empty to collect all.
# Actions: create, update, destroy, login, exported
# ZENDESK_FILTER_ACTIONS=
# Source types: user, rule, ticket, apitoken, zendesk/app_market/app, ...
# ZENDESK_FILTER_SOURCE_TYPES=

# Coralogix Logs API
# Coralogix → Data Flow → API Keys → Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your-coralogix-send-your-data-key
# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com
CORALOGIX_APPLICATION_NAME=zendesk
CORALOGIX_SUBSYSTEM_NAME=audit-logs

# Poll last 5 minutes, every 5 minutes
POLL_INTERVAL_SECONDS=300
LOOKBACK_MINUTES=5
STATE_FILE=./state.json
CORALOGIX_BATCH_SIZE=200
HTTP_TIMEOUT_SECONDS=60
ZENDESK_PAGE_DELAY_SECONDS=0
